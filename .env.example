# Copy to .env and fill in. Never commit .env — it is in .gitignore.
#
# Generate the two secrets with:
#   openssl rand -base64 32     -> REFERRALHUB_STORAGE_ENCRYPTIONKEY
#   openssl rand -hex 32        -> REFERRALHUB_STORAGE_URLSIGNINGSECRET
# or run `make secrets`, which prints a ready-to-paste block.

# --- Datastores -----------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/referralhub
DATABASE_USER=referralhub
DATABASE_PASSWORD=referralhub
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
OPENSEARCH_URI=http://localhost:9200

# --- Object storage -------------------------------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=referralhub
MINIO_SECRET_KEY=referralhub-secret
RESUME_BUCKET=referralhub-resumes

# --- Secrets (no defaults; the app refuses to start without these) --------------------------
REFERRALHUB_STORAGE_ENCRYPTIONKEY=
REFERRALHUB_STORAGE_URLSIGNINGSECRET=

# --- Behaviour ------------------------------------------------------------------------------
CRAWL_ENABLED=true
SEARCH_INDEXER_ENABLED=true
OUTBOX_RELAY_ENABLED=true
LOG_LEVEL=INFO
CRAWLER_USER_AGENT=ReferralHubBot/0.1 (+https://github.com/chauhansachin13/referral-aware-job-platform)
